<main class="main-content">
  <!-- Nav -->
  <nav class="navbar custom-navbar">
    <div class="container-fluid">
      <a class="navbar-brand" href="#"><%= t 'navbar.title', default: 'My SEO Dashboard' %></a>
      
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
            <li><%= link_to t('navbar.home', default: "Home"), dashboard_path, class: "nav-link" %></li>
            <li><%= link_to t('navbar.dashboard', default: "Dashboard"), dashboard_path, class: "nav-link" %></li>
            <li><%= link_to t('navbar.keywords', default: "Keywords"), keywords_path, class: "nav-link" %></li>
            <li><%= link_to t('navbar.searches', default: "Searches"), searches_path, class: "nav-link" %></li>
        </div>
      </div>
    </div>
  </nav>
  
    <header class="top-nav">
      <h1 class="site-title">My SEO Dashboard</h1>
      <div class="nav-container">
        <nav>
          <ul class="main-menu">
            <li><%= link_to "Home", dashboard_path %></li>
            <li><%= link_to "Dashboard", dashboard_path %></li>
            <li><%= link_to "Keywords", keywords_path %></li>
            <li><%= link_to "Searches", searches_path %></li>
            <li class="dropdown">
              <a href="#" class="dropdown-toggle">More</a>
              <ul class="dropdown-menu">
                <li><%= link_to "Alert Settings", alert_settings_path %></li>
                <li><%= link_to "Settings", settings_path %></li>
              </ul>
            </li>
            <% if user_signed_in? %>
              <li class="dropdown">
                <a href="#" class="dropdown-toggle">Account</a>
                <ul class="dropdown-menu">
                  <li><%= link_to "Profile", users_profile_path %></li>
                  <li><%= link_to "Sign Out", destroy_user_session_path, method: :delete, data: { turbo_method: :delete } %></li>
                </ul>
              </li>
            <% else %>
              <li><%= link_to "Sign In", new_user_session_path %></li>
              <li><%= link_to "Sign Up", new_user_registration_path %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

  <%= yield %>
  <!-- Footer -->
  <div class="footer">
        <div>
          &copy; <a href="#">My SEO Dashboard</a>, All Right Reserved.
        </div>
        <div>
          <!--/*** This template is free as long as you keep the footer author’s credit link/attribution link/backlink. If you'd like to use the template without the footer author’s credit link/attribution link/backlink, you can purchase the Credit Removal License from "https://htmlcodex.com/credit-removal". Thank you for your support. ***/-->
          Designed By <a href="">Mama Tech</a>
        </div>
  </div>
</main>
