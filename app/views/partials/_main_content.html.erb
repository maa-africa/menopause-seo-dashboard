<main class="main-content flex-fill" style="margin-left: 250px;">
    <nav class="navbar navbar-light bg-light border-bottom px-3">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">Menopause SEO Dashboard</span>
            <% if user_signed_in? %>
                <span class="navbar-text">
                    Welcome, <%= current_user.name || current_user.email %>
                </span>
            <% end %>
        </div>
    </nav>
    
    <div class="p-4">
        <%= yield %>
    </div>
    
    <!-- Footer Start -->
    <footer class="footer mt-auto py-3 bg-light border-top">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 col-sm-6 text-center text-sm-start">
                    &copy; <a href="#" class="text-decoration-none">Menopause SEO Dashboard</a>, All Rights Reserved. 
                </div>
                <div class="col-12 col-sm-6 text-center text-sm-end">
                    Designed By <a href="#" class="text-decoration-none">Mama Tech</a>
                </div>
            </div>
        </div>
    </footer>
</main>